{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.1.0",
    "@mui/x-charts": "^8.29.3",
    "@mui/x-data-grid": "^8.7.0",
    "@mui/x-date-pickers": "^8.7.0",
    "@react-router/node": "^8.3.0",
    "@tanstack/react-query": "^5.61.0",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-confirm": "^0.5.0",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "react-simple-wheel-picker": "^1.2.0",
    "vite": "^7.0.2",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-confirm": "^0.2.3",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.3.3",
    "sass": "^1.81.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "scripts": {
    "start": "react-router dev --host 0.0.0.0",
    "build": "npm run typecheck && react-router build",
    "serve": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --ignore-path .eslintignore --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
